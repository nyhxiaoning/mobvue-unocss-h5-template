VITE_API_URL = 'https://gateway.jeejio.com'
VITE_CDN_URL = 'https://storage.jeejio.com/webcdn'
VITE_WSS_URL = 'wss://gateway.jeejio.com/router/ws'


## 项目标题
VITE_APP_TITLE = miniapp

## 路由模式 hash 或 html5

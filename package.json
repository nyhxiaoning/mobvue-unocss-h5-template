{
    "name": "applet-vue-sfc",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "build": " vite build && node zip.js",
        "build:prod": " vite build   --mode production  && node zip.js",
        "build:dev": " rimraf dist && vite build  --mode development && node zip.js",
        "build:qa": " rimraf dist && vite build  --mode qa && node zip.js",
        "build:us": " rimraf dist && vite build  --mode us && node zip.js",
        "dev": "vite",
        "dev:qa": "rimraf dist && vite  --mode qa",
        "format": "prettier --cache --write .",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --report-unused-disable-directives",
        "prepare": "husky install",
        "preview": "vite preview",
        "type-check": "vue-tsc --composite false --noEmit"
    },
    "dependencies": {
        "@vueuse/core": "^10.2.1",
        "adm-zip": "^0.5.10",
        "axios": "^1.4.0",
        "dayjs": "^1.11.9",
        "lodash": "^4.17.21",
        "pinia": "^2.1.6",
        "pinia-plugin-persistedstate": "^3.2.0",
        "store2": "^2.14.2",
        "vant": "^4.6.6",
        "vue": "^3.3.4",
        "vue-request": "^2.0.3",
        "vue-router": "^4.2.4"
    },
    "devDependencies": {
        "@rushstack/eslint-patch": "^1.3.0",
        "@types/lodash": "^4.14.195",
        "@types/node": "^20.5.1",
        "@vant/touch-emulator": "^1.4.0",
        "@vitejs/plugin-vue": "^4.2.3",
        "@vitejs/plugin-vue-jsx": "^3.0.1",
        "@vue/eslint-config-prettier": "^7.1.0",
        "@vue/eslint-config-typescript": "^11.0.3",
        "eslint": "^8.41.0",
        "eslint-plugin-vue": "^9.14.1",
        "husky": "^8.0.3",
        "less": "^4.1.3",
        "lint-staged": "^13.2.2",
        "path": "^0.12.7",
        "pinyin-match": "^1.2.6",
        "prettier": "^3.0.0",
        "typescript": "^5.1.6",
        "vite": "^4.4.5",
        "vue-tsc": "^1.8.5",
        "vuex": "^4.1.0"
    }
}
